def Krydsprodukt(x1, y1, z1, x2, y2, z2):
    krydsproduktX = (y1 * z2) - (z1 * y2)
    krydsproduktY = (z1 * x2) - (x1 * z2)
    krydsproduktZ = (x1 * y2) - (y1 * x2)

    return(krydsproduktX, krydsproduktY, krydsproduktZ)