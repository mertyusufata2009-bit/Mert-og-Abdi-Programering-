def ryd_2d_inputs():
    for widget in input_frame_2d.winfo_children():
        widget.destroy()


def lav_input_2d(tekst, x, y):
    label = tk.Label(input_frame_2d, text=tekst, font=("Arial", 18), bg="white", fg="black")
    label.place(x=x, y=y)

    felt = tk.Entry(input_frame_2d, font=("Arial", 18), width=10, bg="lightgray", fg="black", insertbackground="black", relief="solid", bd=2)
    felt.place(x=x + 80, y=y)

    return felt


def opdater_2d_inputs(event):
    global input_x1, input_y1, input_x2, input_y2, input_s, input_r, input_vinkel

    ryd_2d_inputs()

    valg = dropdown_2d.get()

    input_x1 = None
    input_y1 = None
    input_x2 = None
    input_y2 = None
    input_s = None
    input_r = None
    input_vinkel = None

    if valg in ["Addition", "Subtraktion", "Prikprodukt", "Vinkel mellem 2 vektorer", "Projektion", "Punkt til vektor"]:
        input_x1 = lav_input_2d("x1:", 0, 0)
        input_y1 = lav_input_2d("y1:", 250, 0)
        input_x2 = lav_input_2d("x2:", 0, 80)
        input_y2 = lav_input_2d("y2:", 250, 80)

    elif valg in ["Længde", "Vinkel", "Enhedsvektor", "Tværvektor", "Kartesisk til polær"]:
        input_x1 = lav_input_2d("x1:", 0, 0)
        input_y1 = lav_input_2d("y1:", 250, 0)

    elif valg == "Skalar":
        input_x1 = lav_input_2d("x1:", 0, 0)
        input_y1 = lav_input_2d("y1:", 250, 0)
        input_s = lav_input_2d("s:", 0, 80)

    elif valg == "Polær til kartesisk":
        input_r = lav_input_2d("r:", 0, 0)
        input_vinkel = lav_input_2d("vinkel:", 250, 0)

    resultat_label.config(text="Resultat:")


def udregn_2d():
    try:
        valg = dropdown_2d.get()

        if valg == "Addition":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            x2 = float(input_x2.get())
            y2 = float(input_y2.get())
            resultat = FunktionerVektor.Vektor2Dsum(x1, y1, x2, y2)

        elif valg == "Subtraktion":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            x2 = float(input_x2.get())
            y2 = float(input_y2.get())
            resultat = FunktionerVektor.Vektor2Dminus(x1, y1, x2, y2)

        elif valg == "Skalar":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            s = float(input_s.get())
            resultat = FunktionerVektor.Vektor2Dskalar(x1, y1, s)

        elif valg == "Længde":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            resultat = FunktionerVektor.Vektor2Dlængde(x1, y1)

        elif valg == "Vinkel":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            resultat = FunktionerVektor.Vektor2Dvinkel(x1, y1)

        elif valg == "Vinkel mellem 2 vektorer":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            x2 = float(input_x2.get())
            y2 = float(input_y2.get())
            resultat = FunktionerVektor.VinkelMellem2D(x1, y1, x2, y2)

        elif valg == "Kartesisk til polær":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            resultat = FunktionerVektor.KartesiskTilPolaer(x1, y1)

        elif valg == "Polær til kartesisk":
            r = float(input_r.get())
            vinkel = float(input_vinkel.get())
            resultat = FunktionerVektor.PolaerTilKartesisk(r, vinkel)

        elif valg == "Punkt til vektor":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            x2 = float(input_x2.get())
            y2 = float(input_y2.get())
            resultat = FunktionerVektor.PunktTilVektor2D(x1, y1, x2, y2)

        elif valg == "Enhedsvektor":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            resultat = FunktionerVektor.Vektor2Denhedsvektor(x1, y1)

        elif valg == "Tværvektor":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            resultat = FunktionerVektor.Tvaervektor2D(x1, y1)

        elif valg == "Projektion":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            x2 = float(input_x2.get())
            y2 = float(input_y2.get())
            resultat = FunktionerVektor.Projektion2D(x1, y1, x2, y2)

        elif valg == "Prikprodukt":
            x1 = float(input_x1.get())
            y1 = float(input_y1.get())
            x2 = float(input_x2.get())
            y2 = float(input_y2.get())
            resultat = FunktionerVektor.Vektor2Dprikprodukt(x1, y1, x2, y2)

        else:
            resultat_label.config(text="Resultat: Vælg først et regnestykke")
            return

        if isinstance(resultat, tuple):
            resultat = tuple(round(tal, 4) for tal in resultat)
        else:
            resultat = round(resultat, 4)

        resultat_label.config(text=f"Resultat: {resultat}")

    except ValueError:
        resultat_label.config(text="Fejl: Skriv kun tal i felterne")

    except ZeroDivisionError:
        resultat_label.config(text="Fejl: Du kan ikke dividere med 0")

    except Exception as fejl:
        resultat_label.config(text=f"Fejl: {fejl}")


