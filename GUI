def vis_2d_side():
    global dropdown_2d, input_frame_2d, resultat_label

    ryd_vindue()
    Vinduet.configure(bg="white")
    vis_return_knap()

    overskrift = tk.Label(Vinduet, text="2D vektorer", font=("Arial", 30), bg="white", fg="black")
    overskrift.place(x=300, y=80)

    dropdown_2d = ttk.Combobox(Vinduet, font=("Arial", 16), width=28, state="readonly")
    dropdown_2d["values"] = (
        "Addition",
        "Subtraktion",
        "Skalar",
        "Længde",
        "Vinkel",
        "Vinkel mellem 2 vektorer",
        "Kartesisk til polær",
        "Polær til kartesisk",
        "Punkt til vektor",
        "Enhedsvektor",
        "Tværvektor",
        "Projektion",
        "Prikprodukt"
    )
    dropdown_2d.set("Vælg regnestykke")
    dropdown_2d.place(x=180, y=160)
    dropdown_2d.bind("<<ComboboxSelected>>", opdater_2d_inputs)

    input_frame_2d = tk.Frame(Vinduet, bg="white", width=650, height=250)
    input_frame_2d.place(x=150, y=250)

    udregn_knap = tk.Button(Vinduet, text="Udregn", font=("Arial", 18), width=12, command=udregn_2d)
    udregn_knap.place(x=280, y=520)

    resultat_label = tk.Label(Vinduet, text="Resultat:", font=("Arial", 20), bg="white", fg="black")
    resultat_label.place(x=150, y=600)


