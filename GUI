import math
import FunktionerVektor


Vinduet = tk.Tk()

Vinduet.title("Vektorberegner")
Vinduet.geometry("1500x1000")
Vinduet.configure(bg="white")


def ryd_vindue():
    for widget in Vinduet.winfo_children():
        widget.destroy()


